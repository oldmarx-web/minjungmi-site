<!-- Floating piano toggle (generative ambient — pentatonic, royalty-free) -->
<button class="piano-toggle" id="pianoToggle" aria-label="Toggle ambient piano music" aria-pressed="false">
  <span class="piano-icon" aria-hidden="true">♪</span>
  <span class="piano-label">PIANO</span>
</button>

<script>
/* === Ambient piano (vanilla Web Audio API — no external deps) ===
   Generates peaceful pentatonic notes with synthetic reverb. */
(function () {
  var btn = document.getElementById('pianoToggle');
  if (!btn) return;

  var ctx = null, master = null, reverb = null;
  var isPlaying = false;
  var timer = null, step = 0;

  // C major pentatonic frequencies (octaves spread for variety)
  var melody = [
    130.81, 146.83, 164.81, 196.00, 220.00,   // C3..A3
    261.63, 293.66, 329.63, 392.00, 440.00,   // C4..A4
    523.25, 587.33, 659.25, 783.99            // C5..G5
  ];
  var bass = [65.41, 73.42, 98.00];           // C2, D2, G2

  function makeReverb(seconds, decay) {
    var sr = ctx.sampleRate;
    var len = Math.floor(sr * seconds);
    var ir = ctx.createBuffer(2, len, sr);
    for (var c = 0; c < 2; c++) {
      var d = ir.getChannelData(c);
      for (var i = 0; i < len; i++) {
        d[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / len, decay);
      }
    }
    var conv = ctx.createConvolver();
    conv.buffer = ir;
    return conv;
  }

  function note(freq, duration, volume, delay) {
    var t = ctx.currentTime + (delay || 0);
    // Two-oscillator soft “celesta” tone
    var o1 = ctx.createOscillator();
    o1.type = 'triangle';
    o1.frequency.value = freq;

    var o2 = ctx.createOscillator();
    o2.type = 'sine';
    o2.frequency.value = freq * 2.0;

    var g = ctx.createGain();
    g.gain.setValueAtTime(0, t);
    g.gain.linearRampToValueAtTime(volume, t + 0.006);
    g.gain.exponentialRampToValueAtTime(0.0001, t + duration);

    var subG = ctx.createGain();
    subG.gain.value = 0.32;
    o2.connect(subG).connect(g);
    o1.connect(g);

    // Send 65% to reverb, 35% dry
    var send = ctx.createGain(); send.gain.value = 0.65;
    var dry  = ctx.createGain(); dry.gain.value  = 0.35;
    g.connect(dry).connect(master);
    g.connect(send).connect(reverb);

    o1.start(t); o1.stop(t + duration + 0.05);
    o2.start(t); o2.stop(t + duration + 0.05);
  }

  function init() {
    if (ctx) return;
    var AC = window.AudioContext || window.webkitAudioContext;
    if (!AC) return;
    ctx = new AC();
    master = ctx.createGain();
    master.gain.value = 0.55;
    master.connect(ctx.destination);
    reverb = makeReverb(4.5, 3.2);
    reverb.connect(master);
  }

  function tick() {
    if (!isPlaying) return;

    var f = melody[Math.floor(Math.random() * melody.length)];
    note(f, 3.8, 0.16, 0);

    if (Math.random() < 0.32) {
      var f2 = melody[Math.floor(Math.random() * melody.length)];
      note(f2, 3.5, 0.10, 0.18);
    }
    if (step % 4 === 0 || Math.random() < 0.10) {
      var b = bass[Math.floor(Math.random() * bass.length)];
      note(b, 6, 0.09, 0.04);
    }
    step++;

    timer = setTimeout(tick, 1700 + Math.random() * 2000);
  }

  btn.addEventListener('click', function () {
    if (!ctx) {
      try { init(); } catch (e) { console.warn('AudioContext init failed', e); return; }
    }
    if (ctx.state === 'suspended') {
      try { ctx.resume(); } catch (e) {}
    }
    if (isPlaying) {
      isPlaying = false;
      clearTimeout(timer);
      btn.classList.remove('is-playing');
      btn.setAttribute('aria-pressed', 'false');
      btn.querySelector('.piano-label').textContent = 'PIANO';
    } else {
      isPlaying = true;
      step = 0;
      tick();
      btn.classList.add('is-playing');
      btn.setAttribute('aria-pressed', 'true');
      btn.querySelector('.piano-label').textContent = 'MUTE';
    }
  });

  document.addEventListener('visibilitychange', function () {
    if (document.hidden && isPlaying) btn.click();
  });

  // ----- Hint bubble -----
  var hint = document.getElementById('pianoHint');
  var hintClose = document.getElementById('pianoHintClose');
  var hideTimer;
  function dismissHint(remember) {
    if (!hint) return;
    hint.classList.remove('is-visible');
    clearTimeout(hideTimer);
    if (remember) { try { localStorage.setItem('pianoHintDismissed', '1'); } catch (e) {} }
  }
  var alreadyDismissed = false;
  try { alreadyDismissed = !!localStorage.getItem('pianoHintDismissed'); } catch (e) {}
  if (hint && !alreadyDismissed) {
    setTimeout(function () { hint.classList.add('is-visible'); }, 900);
    hideTimer = setTimeout(function () { dismissHint(true); }, 12000);
  }
  if (hintClose) hintClose.addEventListener('click', function () { dismissHint(true); });
  btn.addEventListener('click', function () { dismissHint(true); }, { once: true });
})();
</script>

