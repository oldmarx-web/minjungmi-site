---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

// Load all content collections
const weekly = (await getCollection('weekly')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const monthly = (await getCollection('monthly')).sort(
  (a, b) => b.data.issue_no - a.data.issue_no
);
const therapists = (await getCollection('therapists')).sort(
  (a, b) => a.data.member_no - b.data.member_no
);
const press = (await getCollection('press')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const latestWeekly  = weekly[0];
const pastWeeklies  = weekly.slice(1, 7);
const currentIssue  = monthly[0];
const pastIssues    = monthly.slice(1);

