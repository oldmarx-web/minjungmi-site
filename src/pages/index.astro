---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

// Load all content collections
const weekly = (await getCollection('weekly')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const monthly = (await getCollection('monthly')).sort(
  (a, b) => b.data.issue_no - a.data.issue_no
);
const therapists = (await getCollection('therapists')).sort(
  (a, b) => a.data.member_no - b.data.member_no
);
const press = (await getCollection('press')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const latestWeekly  = weekly[0];
const pastWeeklies  = weekly.slice(1, 7);
const currentIssue  = monthly[0];
const pastIssues    = monthly.slice(1);

// Render the latest weekly letter's markdown body
const LatestLetterContent = latestWeekly ? (await latestWeekly.render()).Content : null;

// Date formatters
const pad2 = (n: number) => String(n).padStart(2, '0');
const pad3 = (n: number) => String(n).padStart(3, '0');
const fmtDate = (d: Date) => `${d.getFullYear()} · ${pad2(d.getMonth() + 1)} · ${pad2(d.getDate())}`;
const fmtVolDate = (d: Date) => `${fmtDate(d)} · FRIDAY`;

