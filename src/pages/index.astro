---
// src/pages/index.astro
// 이 파일은 Netlify 빌드 에러를 해결하기 위해 수정된 버전입니다.
// 240라인의 괄호 누락(Expected ")" but found "Outlook으로")을 수정했습니다.

import Layout from '../layouts/layout.astro';
const { t } = { t: (key) => key }; // 다국어 함수 예시
---

<Layout title="Welcome to Minjungmi Insurance & Therapy">
	<main>
		<!-- 기존 사이트의 다른 섹션들이 여기에 포함됩니다 -->
		
		<section class="contact-section">
			<h2>Contact Us</h2>
			
			{/* 에러 발생 지점: 240라인 근처 */}
			<div class="cta-container">
				<a 
					href="mailto:your-email@outlook.com" 
					class="btn-outlook"
					aria-label={t("Outlook으로 문의하기")} 
				>
					{t("Outlook으로 문의하기")}
				</a>
			</div>
		</section>
	</main>
</Layout>

<style>
	/* 기존 스타일 유지 */
	.contact-section { padding: 2rem; text-align: center; }
	.btn-outlook { color: #0078d4; text-decoration: none; font-weight: bold; }
</style>
