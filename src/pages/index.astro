<script>
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('visible');
        obs.unobserve(e.target);
      }
    });
  }, { threshold: 0.12 });
  document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

  const nav = document.querySelector('nav');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 40) nav.style.padding = '12px 40px';
    else nav.style.padding = '20px 40px';
  });

  // KST clock
  const clk = nav.querySelector('.nav-meta');
  if (clk) {
    const upd = () => {
      const d = new Date();
      const kst = new Date(d.getTime() + (9 * 60 - d.getTimezoneOffset()) * 60000);
      const days = ['SUN','MON','TUE','WED','THU','FRI','SAT'];
      const hh = String(kst.getHours()).padStart(2,'0');
      const mm = String(kst.getMinutes()).padStart(2,'0');
      clk.textContent = `SEOUL · ${days[kst.getDay()]} ${hh}:${mm} KST`;
    };
    upd(); setInterval(upd, 30000);
  }

  // Hero image preload — keep the inline url('insure.jpg') unless the file is missing,
  // in which case fall back to a soft bamboo-toned gradient (do NOT overwrite a successful load).
  const photo = document.querySelector('.hero-photo');
  if (photo) {
    const img = new Image();
    img.onerror = () => {
      photo.style.backgroundImage = 'linear-gradient(160deg, #E9D7AE 0%, #7a9258 55%, #2a3520 100%)';
    };
    img.src = '/images/hero-mobile.jpg';
  }
</script>



